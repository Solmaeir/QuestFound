# Database
DATABASE_URL="postgresql://questfound:questfound_secret@localhost:5432/questfound"

# PostgreSQL (used by docker-compose)
POSTGRES_USER=questfound
POSTGRES_PASSWORD=questfound_secret
POSTGRES_DB=questfound

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Email (magic link auth)
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="noreply@questfound.io"

# App base URL (for internal API calls during SSR)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# OpenAI (for AI scraper parser)
OPENAI_API_KEY="sk-..."
